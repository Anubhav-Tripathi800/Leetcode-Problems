class Solution {
public:
    int subarraySum(vector<int>& nums, int k) {

        int n = nums.size();
        int cnt = 0;

        // Fix the starting index
        for (int i = 0; i < n; i++) {

            int sum = 0;

            // Generate all subarrays starting from i
            for (int j = i; j < n; j++) {

                sum += nums[j];

                // If sum becomes equal to k
                if (sum == k) {
                    cnt++;
                }
            }
        }

        return cnt;
    }
};

class Solution {
public:
    int minSubArrayLen(int target, vector<int>& nums) {
        // int n = nums.size();
        // int minLen = INT_MAX;

        // for (int i = 0; i < n; i++) {
        //     int sum = 0;

        //     for (int j = i; j < n; j++) {
        //         sum += nums[j];

        //         if (sum >= target) {
        //             int len = j - i + 1;
        //             minLen = min(minLen, len);
        //         }
        //     }
        // }

        // if (minLen == INT_MAX)
        //     return 0;

        // return minLen;
        // optimal approach
        int n=nums.size();
        
        
        int minlen=INT_MAX;
        int left=0;
        int sum=0;
        for (int i=0;i<n;i++){
            sum+=nums[i];
            
            while(sum>=target){
                int len=i-left +1;
                minlen=min(len,minlen);
                sum-=nums[left];
                left++;     
       }
    }
            if (minlen==INT_MAX)
            return 0;

            return minlen;
            
    }
};

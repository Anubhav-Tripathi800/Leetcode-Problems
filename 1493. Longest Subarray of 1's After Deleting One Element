class Solution {
public:
    int longestSubarray(vector<int>& nums) {
        int n=nums.size();
        int maxlen=0;
        for(int i=0;i<n;i++){
            int zeros=0;
            for (int j=i;j<n;j++){
                if (nums[j]==0){
                    zeros++;
                }
                if(zeros<=1){
                     int len=j-i+1-1;
                    maxlen=max(len,maxlen);
                }
            else{
                break;
            }
            continue;// continue is being used to avoid duplicate values 
        } 
        
    }
    return maxlen;
    }
    

};

class Solution {
public:
    int largestAltitude(vector<int>& gain) {
        int n=gain.size();
        vector<int> altitude(n+1);
         int currSum=0;
         int maxAltitude=0;
         for (int i =0;i<n;i++){
            currSum+=gain[i];
            altitude[i+1]=currSum;
             maxAltitude = max(maxAltitude, currSum);
         }
         return maxAltitude;
        
    }
};

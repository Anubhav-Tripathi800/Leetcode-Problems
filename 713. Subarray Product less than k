class Solution {
public:
    int numSubarrayProductLessThanK(vector<int>& nums, int k) {
        // Brute force Approach
        // int n=nums.size();
        // int count=0;
        // for (int i=0;i<n;i++){
        //       int product=1;
        //     for (int j=i;j<n;j++){
        //         product=product*nums[j];
        //         if(product<k){
        //             count++;
        //         }
        //         else{
        //             break;
        //     }
        // }
        // }
        // return count;
   // Optimal Approach
        if(k<=1){
            return 0;
        }
        
        int n=nums.size();
        int left=0;
        int right=0;
        int product=1;
        int count=0;
        for (int right=0;right<n;right++){
            product*=nums[right];
            while(product>=k){
                product=product/nums[left];
                left++;
            }
            count+=right-left+1;// this line go through this line again
           

        }
        return count;
        
    }
};
        

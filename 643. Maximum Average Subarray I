class Solution {
public:
    double findMaxAverage(vector<int>& nums, int k) {
        // Brute force solution
         int n=nums.size();
        int maxsum=INT_MIN;
        for (int i=0;i<=n-k;i++){
            int sum=0;
            for(int j=i;j<i+k;j++){
                sum+=nums[j];
            }
            maxsum=max(maxsum,sum);
        }
        return (double)maxsum/k;
         }

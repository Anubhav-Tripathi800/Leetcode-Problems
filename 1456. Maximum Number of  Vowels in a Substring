class Solution {
public:
    int maxVowels(string s, int k) {
        
        // Brute force approach
        //int n=s.size();
        // int ans=0;
        // for (int i=0;i<=n-k;i++){
        //     int count=0;
        
        //     for (int j=i;j<i+k;j++){
        //         if (s[j]=='a'||s[j]=='e'||s[j]=='i'||s[j]=='o'||s[j]=='u'){
        //             count++;
        //         }

        //     }
        //     ans=max(ans,count);

        // }
        // return ans;
        // Optimal Approach
        int n=s.size();
        int count=0;
        for (int i=0;i<k;i++){
            if (s[i]=='a'||s[i]=='e'||s[i]=='i'||s[i]=='o'||s[i]=='u'){
                count++;
            }
        }
            int ans=count;
            for(int i=k;i<n;i++){
                // leaving
                if (s[i-k]=='a'||s[i-k]=='e'||s[i-k]=='i'||s[i-k]=='o'||s[i-k]=='u'){
                    count--;
                    // coming
                } if (s[i]=='a'||s[i]=='e'||s[i]=='i'||s[i]=='o'||s[i]=='u'){
                    count++;
                }
                ans=max(ans,count);
            }
            return ans;
        
        
        
    }
};

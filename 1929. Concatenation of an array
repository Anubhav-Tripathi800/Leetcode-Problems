class Solution {
public:
    vector<int> getConcatenation(vector<int>& nums) {
        // Optimal or easy approach
        // int n=nums.size();
        // for (int i=0;i<n;i++){
        //     nums.push_back(nums[i]);
        // }
        // return nums;
        // Other approach 
        int n=nums.size();
        vector<int> ans(2*n);
        //First copy equal to original size of nums array
        for (int i=0;i<n;i++){
            ans[i]=nums[i];
        }
        // Second copy
        for (int i=0;i<n;i++){
            ans[i+n]=nums[i];
        }
        return ans;
            


        
            
        
    }

  
};

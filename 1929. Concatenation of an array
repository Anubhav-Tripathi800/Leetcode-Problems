class Solution {
public:
    vector<int> getConcatenation(vector<int>& nums) {
        // Approach 1
        int n=nums.size();
         int newlen=2*n;
         vector<int>ans(newlen);

       
         
         for (int i =0 ;i<n;i++){
             ans[i]=nums[i];
         }
         for (int i=n ;i<newlen;i++){
             ans[i]=nums[i-n];
         }
         return ans;
        // Approach 2
        // for (int i =0;i<n;i++){
        //     nums.push_back(nums[i]);
        // }
        // return nums;
    }

  
};
